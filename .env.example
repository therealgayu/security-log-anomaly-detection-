# ==============================================================================
# Security Log Anomaly Detection System (NIIT University Capstone II)
# Root Environment Template
# ==============================================================================
# Copy this file to each service's directory or customize for your environment.
# Never commit actual secrets or production credentials to version control.

# ------------------------------------------------------------------------------
# Global Runtime Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development

# ------------------------------------------------------------------------------
# Backend Service (Node.js + Express)
# ------------------------------------------------------------------------------
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/security_logs_db?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
CLIENT_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# Machine Learning Microservice (Python + FastAPI)
# ------------------------------------------------------------------------------
ML_SERVICE_URL=http://localhost:8000
ML_PORT=8000
ML_HOST=0.0.0.0
MODEL_PATH=models/isolation_forest.joblib
CONTAMINATION_RATE=0.05
RANDOM_STATE=42

# ------------------------------------------------------------------------------
# Frontend Application (React + Vite)
# ------------------------------------------------------------------------------
VITE_PORT=3000
VITE_API_URL=http://localhost:5000/api
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
