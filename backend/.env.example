# ==============================================================================
# Backend Configuration (.env) - Node.js & Express
# Security Log Anomaly Detection System (NIIT University Capstone II)
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=5000

# Database Connection (MongoDB Atlas via Mongoose)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/security_logs_db?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Google OAuth 2.0 (Google Identity Services backend validation)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Machine Learning Microservice Integration
ML_SERVICE_URL=http://localhost:8000

# CORS & Client Origin
CLIENT_ORIGIN=http://localhost:3000

# Logging Level (error, warn, info, http, verbose, debug, silly)
LOG_LEVEL=debug
