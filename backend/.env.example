# Backend Environment Variables
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/security_logs_db?retryWrites=true&w=majority
JWT_SECRET=super_secret_jwt_signing_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
CORS_ORIGIN=http://localhost:3000

# Machine Learning Service
ML_SERVICE_URL=http://localhost:8000
ML_API_KEY=slads_ml_secret_key_2026

# Alert Generation & Thresholds
ALERT_DEDUP_WINDOW_MINUTES=30
ALERT_THRESHOLD_CRITICAL=0.88
ALERT_THRESHOLD_HIGH=0.75
ALERT_THRESHOLD_MEDIUM=0.60

# Inbound Webhooks
INBOUND_WEBHOOK_SECRET=slads_inbound_secret_2026
