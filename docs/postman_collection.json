{
  "info": {
    "_postman_id": "slads-api-collection-v1",
    "name": "SLADS – Security Log Anomaly Detection System API",
    "description": "Complete Postman collection for the NIIT University Capstone II project. Run the 'Login' request first; the token is auto-saved to the {{token}} variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api", "type": "string" },
    { "key": "token",   "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('success is true', () => pm.expect(pm.response.json().success).to.be.true);",
                  "pm.test('Has status field', () => pm.expect(pm.response.json()).to.have.property('status'));",
                  "pm.test('Has database field', () => pm.expect(pm.response.json()).to.have.property('database'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /auth/register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Analyst\",\n  \"email\": \"analyst_{{$randomInt}}@slads.test\",\n  \"password\": \"Secret@12345\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth","register"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Has token', () => pm.expect(pm.response.json().data).to.have.property('token'));",
                  "pm.test('User has no passwordHash', () => pm.expect(pm.response.json().data.user).to.not.have.property('passwordHash'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST /auth/login (saves token)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@test.com\",\n  \"password\": \"Admin@12345\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth","login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('success is true', () => pm.expect(pm.response.json().success).to.be.true);",
                  "pm.test('Has token', () => pm.expect(pm.response.json().data).to.have.property('token'));",
                  "const token = pm.response.json().data.token;",
                  "pm.collectionVariables.set('token', token);",
                  "pm.test('Token saved to variable', () => pm.expect(pm.collectionVariables.get('token')).to.equal(token));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST /auth/login – invalid credentials",
          "request": {
            "method": "POST",
